{
    "name": "angin",
    "version": "0.0.1",
    "description": "A lightweight UI library made for simplicity.",
    "main": "dist/cjs/index.js",
    "module": "dist/esm/index.js",
    "types": "dist/esm/index.d.ts",
    "files": [
        "dist",
        "src/styles"
    ],
    "scripts": {
        "build": "npm run clean && npm run build:cjs && npm run build:esm",
        "build:cjs": "tsc -p tsconfig.json",
        "build:esm": "tsc -p tsconfig.esm.json",
        "build-storybook": "build-storybook",
        "storybook": "start-storybook -p 6006",
        "test": "jest --runInBand",
        "test:watch": "jest --watch",
        "typecheck": "tsc -p tsconfig.test.json",
        "clean": "node scripts/clean.js",
        "check:package": "node scripts/check-package.js",
        "check:bundle": "node scripts/check-bundle.js"
    },
    "author": "yashimwong",
    "license": "MIT",
    "devDependencies": {
        "@types/jest": "^27.4.0",
        "@types/react": "^17.0.38",
        "@types/react-dom": "^17.0.11",
        "@typescript-eslint/eslint-plugin": "^5.10.0",
        "@typescript-eslint/parser": "^5.10.0",
        "@storybook/addon-essentials": "6.5.16",
        "@storybook/builder-webpack5": "6.5.16",
        "@storybook/manager-webpack5": "6.5.16",
        "@storybook/react": "6.5.16",
        "eslint-config-prettier": "^8.3.0",
        "eslint-plugin-prettier": "^4.0.0",
        "eslint-plugin-react": "^7.28.0",
        "jest": "^27.4.7",
        "react": "^17.0.2",
        "react-dom": "^17.0.2",
        "ts-jest": "27.1.3",
        "typescript": "^4.5.4",
        "webpack": "^5.66.0"
    },
    "sideEffects": [
        "**/*.css"
    ],
    "peerDependencies": {
        "react": "^17.0.0 || ^18.0.0 || ^19.0.0",
        "react-dom": "^17.0.0 || ^18.0.0 || ^19.0.0"
    },
    "exports": {
        ".": {
            "types": "./dist/esm/index.d.ts",
            "node": "./dist/cjs/index.js",
            "import": "./dist/esm/index.js",
            "require": "./dist/cjs/index.js",
            "default": "./dist/esm/index.js"
        },
        "./base": {
            "types": "./dist/esm/components/base/index.d.ts",
            "node": "./dist/cjs/components/base/index.js",
            "import": "./dist/esm/components/base/index.js",
            "require": "./dist/cjs/components/base/index.js",
            "default": "./dist/esm/components/base/index.js"
        },
        "./base/*": {
            "types": "./dist/esm/components/base/*.d.ts",
            "node": "./dist/cjs/components/base/*.js",
            "import": "./dist/esm/components/base/*.js",
            "require": "./dist/cjs/components/base/*.js",
            "default": "./dist/esm/components/base/*.js"
        },
        "./derived": {
            "types": "./dist/esm/components/derived/index.d.ts",
            "node": "./dist/cjs/components/derived/index.js",
            "import": "./dist/esm/components/derived/index.js",
            "require": "./dist/cjs/components/derived/index.js",
            "default": "./dist/esm/components/derived/index.js"
        },
        "./derived/*": {
            "types": "./dist/esm/components/derived/*.d.ts",
            "node": "./dist/cjs/components/derived/*.js",
            "import": "./dist/esm/components/derived/*.js",
            "require": "./dist/cjs/components/derived/*.js",
            "default": "./dist/esm/components/derived/*.js"
        },
        "./utils": {
            "types": "./dist/esm/utils/cx.d.ts",
            "node": "./dist/cjs/utils/cx.js",
            "import": "./dist/esm/utils/cx.js",
            "require": "./dist/cjs/utils/cx.js",
            "default": "./dist/esm/utils/cx.js"
        },
        "./src/styles/*": "./src/styles/*",
        "./dist/*": "./dist/*",
        "./package.json": "./package.json",
        "./styles.css": "./src/styles/index.css",
        "./styles/*": "./src/styles/*"
    },
    "typesVersions": {
        "*": {
            "base": [
                "dist/esm/components/base/index.d.ts"
            ],
            "base/*": [
                "dist/esm/components/base/*.d.ts"
            ],
            "derived": [
                "dist/esm/components/derived/index.d.ts"
            ],
            "derived/*": [
                "dist/esm/components/derived/*.d.ts"
            ],
            "utils": [
                "dist/esm/utils/cx.d.ts"
            ]
        }
    },
    "style": "src/styles/index.css"
}
