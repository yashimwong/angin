{
    "extends": "./tsconfig-base.json",
    "compilerOptions": {
        "target": "ES2018",
        "module": "CommonJS",
        "moduleResolution": "Node",
        "lib": ["DOM", "ESNext"],
        "outDir": "dist/cjs",
        "rootDir": "src",
        "jsx": "react",
        "isolatedModules": false
    },
    "include": ["src/**/*.ts", "src/**/*.tsx"]
}
